{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Santa Monica Radio station catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "region", "genres", "stations"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "bundled": { "type": "boolean" },
    "region": {
      "type": "object",
      "required": ["id", "name", "center"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "nameRu", "flag"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" }, "nameRu": { "type": "string" }, "flag": { "type": "string" },
          "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "nameRu", "order", "color"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" }, "nameRu": { "type": "string" },
          "order": { "type": "integer" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "frequency", "genres", "streams", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "callsign": { "type": ["string", "null"] },
          "frequency": { "type": "string" },
          "region": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "city": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "description": { "type": "string" },
          "logo": { "type": ["string", "null"] },
          "homepage": { "type": ["string", "null"] },
          "officialPlayer": { "type": ["string", "null"] },
          "status": { "enum": ["ok", "degraded"] },
          "streams": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "format", "quality", "https", "icy"],
              "properties": {
                "url": { "type": "string", "pattern": "^https?://" },
                "format": { "enum": ["mp3", "aac", "hls", "ogg", "opus"] },
                "bitrate": { "type": ["integer", "null"] },
                "quality": { "enum": ["high", "medium", "low"] },
                "https": { "type": "boolean" },
                "icy": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
